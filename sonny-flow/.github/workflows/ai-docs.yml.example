name: Auto-update AI-facing docs

# Giữ cho bộ docs dành cho AI (code_map / dependencies / module_index) bám theo code mới nhất.
# Chi tiết vận hành xem docs/ai-docs.md.
#
# Các chế độ chạy:
#   - push (develop)     : tự động cập nhật rồi push thẳng (nếu fast-forward được)
#   - pull_request       : dry-run. Diff giữa bản sinh ra và bản hiện tại quá lớn thì CI fail
#   - workflow_dispatch  : chạy tay
#   - schedule           : batch ban đêm (đề phòng sót diff)
#
# Lưu ý bảo mật:
#   Các đường dẫn file lấy từ diff sẽ được nhúng vào LLM prompt của docs-keeper
#   (có thể trở thành bề mặt prompt injection). pull_request đến từ fork thì
#   phải giữ nguyên dry-run, không được chạy apply/force cho PR từ fork.

on:
  push:
    branches: [develop]
    paths:
      - 'Arent3d.Architecture.Routing*/**'
      - 'Tests/**'
  pull_request:
    paths:
      - 'Arent3d.Architecture.Routing*/**'
      - 'Tests/**'
  workflow_dispatch:
    inputs:
      mode:
        description: 'dry-run / apply / force'
        required: false
        default: 'dry-run'
  schedule:
    - cron: '0 18 * * *'  # mỗi ngày 03:00 JST (18:00 UTC)

permissions:
  contents: write
  pull-requests: write

jobs:
  update-ai-docs:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 2  # lấy 2 thế hệ để làm diff

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'

      - name: Install Claude Code
        run: npm install -g @anthropic-ai/claude-code

      - name: Run docs-keeper (dry-run on PR, apply on push)
        env:
          ANTHROPIC_API_KEY: ${{ secrets.ANTHROPIC_API_KEY }}
        run: |
          MODE="${{ github.event.inputs.mode || (github.event_name == 'pull_request' && 'dry-run' || 'apply') }}"
          chmod +x scripts/update-ai-docs.sh
          ./scripts/update-ai-docs.sh "$MODE"

      - name: Check diff size (dry-run mode)
        if: github.event_name == 'pull_request'
        run: |
          # --numstat cho ra dạng "thêm TAB xoá TAB path", nên chỉ thêm/chỉ xoá/binary đều không lệch cột
          LINES_CHANGED=$(git diff --numstat docs/domain/generated/code_map.md docs/domain/generated/dependencies.md docs/domain/generated/module_index.md | awk '{s+=$1+$2} END {print s+0}')
          LINES_CHANGED=${LINES_CHANGED:-0}
          echo "AI docs diff lines: $LINES_CHANGED"
          if [ "$LINES_CHANGED" -gt 200 ]; then
            echo "::error::Diff của bộ docs dành cho AI quá lớn ($LINES_CHANGED dòng). Hãy chạy tay /docs-update để kiểm tra tính nhất quán."
            exit 1
          fi

      - name: Commit & push (on develop)
        if: github.event_name == 'push' && github.ref == 'refs/heads/develop'
        run: |
          if [ -n "$(git status --porcelain docs/domain/)" ]; then
            git config user.name "ai-docs-bot"
            git config user.email "ai-docs-bot@users.noreply.github.com"
            git add docs/domain/generated/code_map.md docs/domain/generated/dependencies.md docs/domain/generated/module_index.md
            git commit -m "chore(docs): auto-update AI-facing docs

            Generated by: docs-keeper agent
            Details: deliverables/00_onboarding/docs-update-*.json"
            git push
          else
            echo "No changes to AI-facing docs"
          fi

      - name: Upload update summary
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: docs-update-summary
          path: deliverables/00_onboarding/docs-update-*.json
          if-no-files-found: ignore
